{
	"name": "kinkyvibe",
	"version": "1.1.0",
	"private": true,
	"scripts": {
		"predev": "node scripts/db-migrate-local.js && node scripts/import-content.js --soft --no-migrate",
		"dev": "vite dev",
		"predev:tickets": "node scripts/db-migrate-local.js && node scripts/import-content.js --soft --no-migrate",
		"dev:tickets": "vite dev --mode tickets",
		"predev:admin": "node scripts/db-migrate-local.js && node scripts/import-content.js --soft --no-migrate",
		"dev:admin": "vite dev --mode admin",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"test": "npm run test:unit && npm run test:e2e",
		"test:e2e": "playwright test",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"db:migrate:local": "wrangler d1 migrations apply kinkyvibe --local",
		"db:migrate:remote": "wrangler d1 migrations apply kinkyvibe --remote",
		"db:migrate:preview": "node scripts/db-migrate-preview.js",
		"db:migrations:new": "wrangler d1 migrations create kinkyvibe",
		"preview:worker": "wrangler dev --port 8880 --test-scheduled",
		"db:restore": "node scripts/d1-restore.js",
		"amigues:import": "node scripts/import-amigues.js",
		"tags:import": "node scripts/import-tags.js",
		"content:import": "node scripts/import-content.js",
		"images:import": "node scripts/import-images.js",
		"lint": "eslint .",
		"format:check": "prettier --check .",
		"format": "prettier --write .",
		"ui:impacto": "node scripts/ui-impacto/run.js",
		"demo:local": "node scripts/demo/recargar-local.js"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260929.1",
		"@eslint/js": "^8.57.1",
		"@jsdevtools/rehype-toc": "^3.0.2",
		"@melt-ui/pp": "^0.3.2",
		"@melt-ui/svelte": "^0.86.6",
		"@playwright/test": "^1.28.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"autoprefixer": "^10.6.1",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^8.5.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^16.5.0",
		"mdsvex": "^0.12.8",
		"pixelmatch": "7.2.0",
		"pngjs": "7.0.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"rehype": "^12.0.1",
		"rehype-slug": "^5.1.0",
		"sass": "^1.105.1",
		"schema-dts": "^1.1.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"svelte-preprocess": "^6.0.5",
		"typescript": "^5.0.0",
		"vite": "^8.3.3",
		"vitest": "^5.0.3",
		"wrangler": "^4.149.0"
	},
	"type": "module",
	"dependencies": {
		"@codemirror/lang-markdown": "^6.2.2",
		"@event-calendar/core": "^5.16.0",
		"@lucide/svelte": "^1.52.0",
		"add-to-calendar-button": "^2.2.10",
		"date-fns": "^2.30.0",
		"hast-util-find-and-replace": "^4.1.3",
		"hast-util-has-property": "^2.0.1",
		"hast-util-heading-rank": "^2.1.1",
		"hastscript": "^8.0.0",
		"ics": "^3.12.1",
		"micromark": "^3.2.0",
		"micromark-extension-gfm": "^2.0.3",
		"qrcode-generator": "^2.0.4",
		"rehype-sanitize": "^5.0.1",
		"simple-icons": "^8.14.0",
		"svelte-codemirror-editor": "^2.1.0",
		"unist-util-visit": "^5.1.0",
		"uqr": "^0.1.3",
		"yaml": "^2.4.1"
	}
}
