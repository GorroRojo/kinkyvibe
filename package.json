{
	"name": "kinkyvibe",
	"version": "1.1.0",
	"private": true,
	"scripts": {
		"predev": "node scripts/db-migrate-local.js",
		"dev": "vite dev",
		"dev:admin": "vite dev --mode admin",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"test": "npm run test:unit && npm run test:e2e",
		"test:e2e": "playwright test",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"lint": "eslint .",
		"format:check": "prettier --check .",
		"db:migrate:local": "wrangler d1 migrations apply kinkyvibe --local",
		"db:migrate:remote": "wrangler d1 migrations apply kinkyvibe --remote",
		"db:migrations:new": "wrangler d1 migrations create kinkyvibe",
		"preview:worker": "wrangler pages dev .svelte-kit/cloudflare --port 8880",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260929.1",
		"@jsdevtools/rehype-toc": "^3.0.2",
		"@melt-ui/pp": "^0.3.2",
		"@melt-ui/svelte": "^0.86.6",
		"@playwright/test": "^1.28.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"autoprefixer": "^10.4.14",
		"eslint": "^8.28.0",
		"eslint-config-prettier": "^8.5.0",
		"eslint-plugin-svelte": "^2.46.1",
		"mdsvex": "^0.12.8",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"rehype-slug": "^5.1.0",
		"sass": "^1.62.0",
		"schema-dts": "^1.1.2",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-preprocess": "^6.0.5",
		"typescript": "^5.0.0",
		"vite": "^8.3.1",
		"vitest": "^5.0.2"
	},
	"type": "module",
	"dependencies": {
		"@codemirror/lang-markdown": "^6.2.2",
		"@lucide/svelte": "^1.48.0",
		"@octokit/core": "^4.2.0",
		"add-to-calendar-button": "^2.2.10",
		"buffer": "^6.0.3",
		"date-fns": "^2.30.0",
		"hast-util-find-and-replace": "^4.1.3",
		"hast-util-has-property": "^2.0.1",
		"hast-util-heading-rank": "^2.1.1",
		"hast-util-to-string": "^2.0.0",
		"hastscript": "^8.0.0",
		"ics": "^3.2.0",
		"rehype": "^12.0.1",
		"rehype-autolink-headings": "^6.1.1",
		"remark-gfm": "^3.0.1",
		"simple-icons": "^8.14.0",
		"svelte-codemirror-editor": "^2.1.0",
		"unist-util-visit": "^5.0.0",
		"wrangler": "^4.143.0",
		"yaml": "^2.4.1"
	}
}
