# Modo de prueba de la venta de entradas: `npm run dev:tickets` (= vite dev --mode tickets).
# Vite/SvelteKit leen este archivo solo en ese modo. SOLO flags de desarrollo, nada secreto:
# este archivo está en el repo (público). Para cambiar algo solo en tu compu, creá
# `.env.tickets.local` (lo ignora git) con las variables que quieras pisar.

# Mercado Pago simulado (no se cobra nada) y sesión de admin falsa (sin GitHub). Solo en dev.
MP_MOCK=1
ADMIN_DEV_MOCK=1

# Comisión de Mercado Pago que se suma como recargo (la que decidió la organización por defecto:
# 2 %; la real varía y se ajusta en /admin/entradas/ajustes).
TICKETS_MP_FEE_PERCENT=2

# Datos de transferencia INVENTADOS (nunca poner datos reales acá).
TICKETS_TRANSFER_INFO="Alias: EJEMPLO.ALIAS.PRUEBA\nCBU: 0000000000000000000000\nTitular: Nombre de ejemplo"

# Porcentaje del Fondo KinkyVibe para probar sin red (en producción sale solo de
# https://fondo.kinkyvibe.ar/api/porcentaje). Solo se usa en `vite dev`.
FONDO_PERCENT_OVERRIDE=20

# Secreto del cron de recordatorios SOLO para probar en local (en producción es un Secret de
# Cloudflare, distinto y largo): curl -X POST localhost:5173/api/cron/recordatorios -H "x-cron-secret: dev-cron-secret-solo-local"
CRON_SECRET=dev-cron-secret-solo-local
