# Modo de prueba de la venta de entradas: `npm run dev:tickets` (= vite dev --mode tickets).
# Vite/SvelteKit leen este archivo solo en ese modo. SOLO flags de desarrollo, nada secreto:
# este archivo está en el repo (público). Para cambiar algo solo en tu compu, creá
# `.env.tickets.local` (lo ignora git) con las variables que quieras pisar.

# Mercado Pago simulado (no se cobra nada) y sesión de admin falsa (sin GitHub). Solo en dev.
MP_MOCK=1
ADMIN_DEV_MOCK=1

# Comisión de Mercado Pago que se suma como recargo (ejemplo, sin verificar).
TICKETS_MP_FEE_PERCENT=7.73

# Datos de transferencia INVENTADOS (nunca poner datos reales acá).
TICKETS_TRANSFER_INFO="Alias: EJEMPLO.ALIAS.PRUEBA\nCBU: 0000000000000000000000\nTitular: Nombre de ejemplo"
